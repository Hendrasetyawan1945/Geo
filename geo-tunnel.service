[Unit]
Description=Geo CodeIgniter Cloudflare Tunnel
After=network.target

[Service]
Type=simple
User=ubuntu
# Token dipindahkan ke environment variable / secret management demi keamanan
Environment="TUNNEL_TOKEN=[REDACTED_CLOUDFLARE_TUNNEL_TOKEN]"
ExecStart=/usr/local/bin/cloudflared tunnel run --token ${TUNNEL_TOKEN}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geo-tunnel

[Install]
WantedBy=multi-user.target
