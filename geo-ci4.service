[Unit]
Description=Geo CodeIgniter 4 Application Server
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/html/Geo
ExecStart=/usr/local/bin/php spark serve --host=0.0.0.0 --port=8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=geo-ci4

[Install]
WantedBy=multi-user.target
